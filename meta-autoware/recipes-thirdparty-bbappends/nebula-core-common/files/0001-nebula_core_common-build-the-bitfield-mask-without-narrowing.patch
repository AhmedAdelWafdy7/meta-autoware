From: Ahmed Adel Wafdy <fandes99@gmail.com>
Subject: [PATCH] nebula_core_common: build the bitfield mask without narrowing

For an 8-bit InT, all_ones << n_bits is computed as int, and narrowing
its complement back to InT is an error with GCC 15 (-Werror=overflow).
Shift the all-ones value right instead, as upstream now does.

Only the mask change of the upstream commit, without its new
static_asserts.

Upstream-Status: Backport [https://github.com/tier4/nebula/commit/369bfa78d5fc22a3d37ce2675d837dc0025da23c]
Signed-off-by: Ahmed Adel Wafdy <fandes99@gmail.com>
---
 include/nebula_core_common/util/bitfield.hpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/include/nebula_core_common/util/bitfield.hpp b/include/nebula_core_common/util/bitfield.hpp
--- a/include/nebula_core_common/util/bitfield.hpp
+++ b/include/nebula_core_common/util/bitfield.hpp
@@ -43,7 +43,8 @@ constexpr OutT get_bitfield(const InT & storage)
 {
   constexpr uint8_t n_bits = HighBit - LowBit + 1;
   constexpr InT all_ones = ~static_cast<InT>(0);
-  constexpr InT mask = ~(all_ones << n_bits);
+  constexpr auto storage_bits = static_cast<uint8_t>(sizeof(InT) * 8U);
+  constexpr InT mask = static_cast<InT>(all_ones >> (storage_bits - n_bits));
 
   InT raw_value = (storage >> LowBit) & mask;
   return static_cast<OutT>(raw_value);
