From 1d81b82074908188bf511f9554cf36cdfeedbe65 Mon Sep 17 00:00:00 2001
From: Ahmed Adel Wafdy <fandes99@gmail.com>
Date: Mon, 16 Nov 2026 12:04:04 +0000
Subject: [PATCH] fix(autoware_behavior_path_goal_planner_module): link against
 TBB

goal_planner_module.cpp sorts with std::execution::par. libstdc++
implements the parallel algorithms with TBB, so the library calls TBB,
but it does not link it. Lazy binding hides this until the code runs.
Linked with -z now, dlopen fails ("undefined symbol:
tbb::detail::r1::spawn") and the behavior path planner does not load.

Find TBB through its CMake config (the FindTBB.cmake module in
mrt_cmake_modules predates oneTBB), link TBB::tbb, and declare the
dependency.

Upstream-Status: Submitted [https://github.com/autowarefoundation/autoware_universe/pull/13639]
Signed-off-by: Ahmed Adel Wafdy <fandes99@gmail.com>
---
 CMakeLists.txt | 5 +++++
 package.xml    | 1 +
 2 files changed, 6 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a0df0d3055..e9fb8698cb 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -25,6 +25,11 @@ ament_auto_add_library(${PROJECT_NAME} SHARED
   src/lane_change.cpp
 )
 
+# std::execution::par in goal_planner_module.cpp runs on TBB in libstdc++. CONFIG: the
+# FindTBB.cmake in mrt_cmake_modules predates oneTBB and cannot find it
+find_package(TBB CONFIG REQUIRED)
+target_link_libraries(${PROJECT_NAME} TBB::tbb)
+
 if(BUILD_EXAMPLES)
   message(STATUS "Building examples")
   include(FetchContent)
diff --git a/package.xml b/package.xml
index 982a1665b7..9f0583b2e5 100644
--- a/package.xml
+++ b/package.xml
@@ -28,6 +28,7 @@
   <depend>pluginlib</depend>
   <depend>range-v3</depend>
   <depend>rclcpp</depend>
+  <depend>tbb</depend>
   <depend>visualization_msgs</depend>
 
   <test_depend>ament_cmake_ros</test_depend>
-- 
