From: Ahmed Adel Wafdy <fandes99@gmail.com>
Subject: [PATCH] fix(yabloc_common): remove unused using-declaration

GCC 15 reports unused using-declarations under -Wunused-variable, which
this package builds with -Werror. _2 is never used in this function.

Upstream-Status: Pending
Signed-off-by: Ahmed Adel Wafdy <fandes99@gmail.com>
---
 src/ground_server/ground_server_core.cpp | 1 -
 1 file changed, 1 deletion(-)

diff --git a/src/ground_server/ground_server_core.cpp b/src/ground_server/ground_server_core.cpp
index 8ab15d6428..9ca33c3a7a 100644
--- a/src/ground_server/ground_server_core.cpp
+++ b/src/ground_server/ground_server_core.cpp
@@ -44,7 +44,6 @@ GroundServer::GroundServer(const rclcpp::NodeOptions & options)
   K_(static_cast<int>(declare_parameter<int>("K")))
 {
   using std::placeholders::_1;
-  using std::placeholders::_2;
   const rclcpp::QoS map_qos = rclcpp::QoS(1).transient_local().reliable();
 
   auto on_pose = std::bind(&GroundServer::on_pose_stamped, this, _1);
