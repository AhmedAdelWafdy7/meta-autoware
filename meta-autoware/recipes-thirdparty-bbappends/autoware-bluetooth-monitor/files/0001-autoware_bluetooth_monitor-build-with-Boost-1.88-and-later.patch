From: Ahmed Adel Wafdy <fandes99@gmail.com>
Subject: [PATCH] fix(autoware_bluetooth_monitor): build with Boost 1.88 and later

Boost 1.88 made Boost.Process v2 the default: boost/process.hpp now
declares the v2 API, and v1 lives in boost/process/v1.hpp. Code written
against v1 stops compiling ("pipe is not a member of bp").

When the v1 headers exist (Boost 1.86 and later), set
BOOST_PROCESS_VERSION=1, which makes v1 the inline namespace again so
boost::process:: names keep resolving to the v1 API, and include
boost/process/v1.hpp. Boost 1.88 has the v1 headers but not v1.hpp, so
there the headers v1.hpp would include are listed one by one. Older
Boost (Ubuntu 24.04 has 1.83) takes the #else branch and is unchanged.

l2ping.cpp also uses std::ostringstream without including <sstream>; the
old boost/process.hpp happened to include it.

Tested by cross-compiling with Boost 1.90 and GCC 15 (Yocto wrynose).

Upstream-Status: Submitted [https://github.com/autowarefoundation/autoware_bluetooth_monitor/pull/5]
Signed-off-by: Ahmed Adel Wafdy <fandes99@gmail.com>
---
 service/l2ping.cpp         | 30 ++++++++++++++++++++++++++++++
 service/l2ping_service.cpp | 29 +++++++++++++++++++++++++++++
 2 files changed, 59 insertions(+)

diff --git a/service/l2ping.cpp b/service/l2ping.cpp
index 4911825e5b..8cdf1b7771 100644
--- a/service/l2ping.cpp
+++ b/service/l2ping.cpp
@@ -15,11 +15,41 @@
 
 #include "autoware/bluetooth_monitor/service/l2ping.hpp"
 
+// Boost 1.88 made Boost.Process v2 the default; v1 stays available under boost/process/v1/
+#if __has_include(<boost/process/v1/child.hpp>)
+#ifndef BOOST_PROCESS_VERSION
+#define BOOST_PROCESS_VERSION 1
+#endif
+#if __has_include(<boost/process/v1.hpp>)
+#include <boost/process/v1.hpp>
+#else  // Boost 1.88 has the v1 headers but not v1.hpp
+#include <boost/process/v1/args.hpp>
+#include <boost/process/v1/async.hpp>
+#include <boost/process/v1/async_system.hpp>
+#include <boost/process/v1/group.hpp>
+#include <boost/process/v1/child.hpp>
+#include <boost/process/v1/cmd.hpp>
+#include <boost/process/v1/env.hpp>
+#include <boost/process/v1/environment.hpp>
+#include <boost/process/v1/error.hpp>
+#include <boost/process/v1/exe.hpp>
+#include <boost/process/v1/handles.hpp>
+#include <boost/process/v1/io.hpp>
+#include <boost/process/v1/pipe.hpp>
+#include <boost/process/v1/shell.hpp>
+#include <boost/process/v1/search_path.hpp>
+#include <boost/process/v1/spawn.hpp>
+#include <boost/process/v1/system.hpp>
+#include <boost/process/v1/start_dir.hpp>
+#endif
+#else
 #include <boost/process.hpp>
+#endif
 
 #include <syslog.h>
 
 #include <regex>
+#include <sstream>
 #include <string>
 
 #define FMT_HEADER_ONLY
diff --git a/service/l2ping_service.cpp b/service/l2ping_service.cpp
index 20bb610469..c51de8eb1d 100644
--- a/service/l2ping_service.cpp
+++ b/service/l2ping_service.cpp
@@ -16,7 +16,36 @@
 
 #include <boost/archive/text_iarchive.hpp>
 #include <boost/archive/text_oarchive.hpp>
+// Boost 1.88 made Boost.Process v2 the default; v1 stays available under boost/process/v1/
+#if __has_include(<boost/process/v1/child.hpp>)
+#ifndef BOOST_PROCESS_VERSION
+#define BOOST_PROCESS_VERSION 1
+#endif
+#if __has_include(<boost/process/v1.hpp>)
+#include <boost/process/v1.hpp>
+#else  // Boost 1.88 has the v1 headers but not v1.hpp
+#include <boost/process/v1/args.hpp>
+#include <boost/process/v1/async.hpp>
+#include <boost/process/v1/async_system.hpp>
+#include <boost/process/v1/group.hpp>
+#include <boost/process/v1/child.hpp>
+#include <boost/process/v1/cmd.hpp>
+#include <boost/process/v1/env.hpp>
+#include <boost/process/v1/environment.hpp>
+#include <boost/process/v1/error.hpp>
+#include <boost/process/v1/exe.hpp>
+#include <boost/process/v1/handles.hpp>
+#include <boost/process/v1/io.hpp>
+#include <boost/process/v1/pipe.hpp>
+#include <boost/process/v1/shell.hpp>
+#include <boost/process/v1/search_path.hpp>
+#include <boost/process/v1/spawn.hpp>
+#include <boost/process/v1/system.hpp>
+#include <boost/process/v1/start_dir.hpp>
+#endif
+#else
 #include <boost/process.hpp>
+#endif
 
 #include <sys/socket.h>
 #include <syslog.h>
